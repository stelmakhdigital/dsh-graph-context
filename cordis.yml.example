# User-facing overlay example: point the plugin at a specific engine CLI
# binary and loosen the query budget. Copy into your profile's
# cordis.patch.yml (or use `dsh --patch` for a one-off boot).
#
# A patch replaces a row's ENTIRE config — restate every key you want to keep.
- insert:
    - id: context-graph
      name: 'dsh-context-graph'
      inject: ['tools', 'systemPrompt']
      config:
        tools: true
        injectSessionMap: true
        injectPromptHits: true
        injectBlastRadius: true
        autoBuild: true
        autoSync: true
        maxInjectBytes: 8192
        promptMinChars: 12
        graphPath: '/usr/local/bin/graft'
        timeoutMs: 8000
        buildTimeoutMs: 30000
        deep:
          # P2c #7 — local LLM deep pass (graph_enrich). OFF by default:
          # the pass is CPU-heavy; enable only with a local endpoint (Ollama):
          #   deep:
          #     tool: true
          #     model: qwen2.5-coder:7b
          #     baseUrl: http://127.0.0.1:11434/v1
          #     provider: openai
          #     apiKey: ollama          # or apiKeyEnv: NAME (ambient GRAFT_API_KEY is never read)
          tool: false
        watcher: false  # P2c #17 — file watcher over sources (IDE/TUI scenario)
        editToolNames: ['write', 'edit']
        injectMode: sourced
        nudgeOnBlindSearch: true
        scopeFromLastEdit: false
        metrics: true
        guardWiringReads: false
        # short repo map into subagents on agent/created (P2b)
        injectSubagentMap: true
        # re-inject the short map once after the host compacts the session (P2b)
        reinjectAfterCompaction: true
        # list the graph tools first in the assembled prompt (P2b)
        toolOrder: true
        blastOnResume: true
